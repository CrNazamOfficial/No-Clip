    -- =====================
    -- CORE AIRWALK LOGIC
    -- =====================

    local function stopAirWalk()
        if walkConnection then walkConnection:Disconnect(); walkConnection = nil end
        if airPart then airPart:Destroy(); airPart = nil end
        currentHeight = 0
    end

    local function startAirWalk()
        if not (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) then return end

        local hrp = player.Character.HumanoidRootPart
        -- Set platform tepat di bawah kaki saat ini
        currentHeight = hrp.Position.Y - 3.2

        -- Buat platform
        if airPart then airPart:Destroy() end
        airPart = Instance.new("Part")
        airPart.Name = "AirWalkPlatform"
        airPart.Size = Vector3.new(14, 0.4, 14)
        airPart.Anchored = true
        airPart.CanCollide = true
        airPart.Transparency = 0.4
        airPart.Material = Enum.Material.Neon
        airPart.Color = Color3.fromRGB(80, 255, 80)
        airPart.CastShadow = false
        airPart.Parent = workspace
        -- Posisi awal langsung di bawah kaki
        airPart.CFrame = CFrame.new(hrp.Position.X, currentHeight, hrp.Position.Z)

        local prevState = nil

        if walkConnection then walkConnection:Disconnect() end
        walkConnection = RunService.Heartbeat:Connect(function()
            if not (player.Character
                and player.Character:FindFirstChild("HumanoidRootPart")
                and player.Character:FindFirstChild("Humanoid")) then return end

            local h = player.Character.HumanoidRootPart
            local humanoid = player.Character.Humanoid
            local state = humanoid:GetState()

            local inAir = (
                state == Enum.HumanoidStateType.Jumping or
                state == Enum.HumanoidStateType.Freefall
            )

            local justLanded = (
                prevState ~= nil and
                (prevState == Enum.HumanoidStateType.Freefall or prevState == Enum.HumanoidStateType.Jumping) and
                not inAir
            )

            if inAir then
                -- Di udara: platform diam di currentHeight, collision off
                -- Platform tidak bergerak sama sekali, hanya ikut X/Z
                airPart.CanCollide = false
                airPart.CFrame = CFrame.new(h.Position.X, currentHeight, h.Position.Z)
            else
                if justLanded then
                    -- Baru landing: snap height ke posisi kaki sekarang
                    -- Tunggu 1 frame supaya physics settle
                    task.defer(function()
                        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and airPart then
                            currentHeight = player.Character.HumanoidRootPart.Position.Y - 3.2
                            airPart.CFrame = CFrame.new(
                                player.Character.HumanoidRootPart.Position.X,
                                currentHeight,
                                player.Character.HumanoidRootPart.Position.Z
                            )
                            airPart.CanCollide = true
                        end
                    end)
                else
                    -- Jalan biasa: ikuti X/Z, height tetap
                    airPart.CFrame = CFrame.new(h.Position.X, currentHeight, h.Position.Z)
                    airPart.CanCollide = true
                end
            end

            prevState = state
        end)
    end

    local function updateUI()
        if _G.AirWalkEnabled then
            toggleBtn.Text = "AirWalk: ON"
            toggleBtn.TextColor3 = Color3.fromRGB(80, 255, 80)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(18, 70, 18)
            toggleBtn.BorderColor3 = Color3.fromRGB(80, 255, 80)
            statusLabel.Text = "Status: Active"
        else
            toggleBtn.Text = "AirWalk: OFF"
            toggleBtn.TextColor3 = Color3.fromRGB(140, 140, 140)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
            toggleBtn.BorderColor3 = Color3.fromRGB(55, 55, 55)
            statusLabel.Text = "Status: Ready"
        end
    end

    toggleBtn.MouseButton1Click:Connect(function()
        _G.AirWalkEnabled = not _G.AirWalkEnabled
        if _G.AirWalkEnabled then
            startAirWalk()
        else
            stopAirWalk()
        end
        updateUI()
    end)

    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if _G.AirWalkEnabled then
            _G.AirWalkEnabled = false
            stopAirWalk()
            updateUI()
        end
    end)

    -- CLOSE / MINIMIZE
    local isMinimized = false
    closeBtn.MouseButton1Click:Connect(function()
        mainFrame.Visible = false
        iconButton.Visible = true
        isMinimized = true
    end)
    iconClickBtn.MouseButton1Click:Connect(function()
        mainFrame.Visible = true
        iconButton.Visible = false
        isMinimized = false
    end)

    -- DRAG MAIN FRAME
    local UIS = game:GetService("UserInputService")
    local dragging, dragStart, startPos = false, nil, nil

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- DRAG ICON
    local iconDragging, iconDragStart, iconStartPos = false, nil, nil

    iconButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            iconDragging = true
            iconDragStart = input.Position
            iconStartPos = iconButton.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then iconDragging = false end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if iconDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - iconDragStart
            iconButton.Position = UDim2.new(iconStartPos.X.Scale, iconStartPos.X.Offset + delta.X, iconStartPos.Y.Scale, iconStartPos.Y.Offset + delta.Y)
        end
    end)
end

