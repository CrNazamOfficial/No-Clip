    local function updateAirWalk()
        if _G.AirWalkEnabled then
            if not airPart then
                -- Create solid platform
                airPart = Instance.new("Part")
                airPart.Size = Vector3.new(10, 0.5, 10)
                airPart.Anchored = true
                airPart.Transparency = 0.5
                airPart.CanCollide = true
                airPart.Material = Enum.Material.Neon
                airPart.Color = Color3.fromRGB(80, 255, 80)
                airPart.Parent = workspace
                airPart.Name = "AirWalkPlatform_" .. player.UserId
                
                -- Make sure player can walk on it
                for _, part in pairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        local noCollide = Instance.new("NoCollisionConstraint")
                        noCollide.Part0 = airPart
                        noCollide.Part1 = part
                        noCollide.Parent = airPart
                    end
                end
            end
            
            if not walkConnection then
                walkConnection = RunService.Heartbeat:Connect(function()
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = player.Character.HumanoidRootPart
                        
                        if _G.AirWalkHeight == 0 then
                            airPart.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.5, hrp.Position.Z)
                        else
                            airPart.CFrame = CFrame.new(hrp.Position.X, _G.AirWalkHeight, hrp.Position.Z)
                        end
                        
                        airPart.CanCollide = true
                        airPart.Anchored = true
                    end
                end)
            end
            
            if not jumpConnection then
                jumpConnection = RunService.Heartbeat:Connect(function()
                    if player.Character then
                        local humanoid = player.Character:FindFirstChild("Humanoid")
                        if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Jumping then
                            if player.Character:FindFirstChild("HumanoidRootPart") then
                                _G.AirWalkHeight = player.Character.HumanoidRootPart.Position.Y
                            end
                        end
                    end
                end)
            end
            
            statusLabel.Text = "Status: AirWalk Active"
        else
            if airPart then
                airPart:Destroy()
                airPart = nil
            end
            if walkConnection then
                walkConnection:Disconnect()
                walkConnection = nil
            end
            if jumpConnection then
                jumpConnection:Disconnect()
                jumpConnection = nil
            end
            _G.AirWalkHeight = 0
            if not _G.LockMovement then
                statusLabel.Text = "Status: Ready"
            end
        end
    end
    
    local function updateMoveLock()
        if _G.LockMovement then
            lockedRotation = nil
            
            if not lockConnection then
                lockConnection = RunService.Heartbeat:Connect(function()
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = player.Character.HumanoidRootPart
                        local humanoid = player.Character:FindFirstChild("Humanoid")
                        
                        if humanoid then
                            -- Lock rotation saat pertama kali aktif
                            if not lockedRotation then
                                lockedRotation = hrp.CFrame.LookVector
                            end
                            
                            -- Get movement input
                            local moveVector = humanoid.MoveVector
                            
                            if moveVector.Magnitude > 0 then
                                -- Calculate forward/backward only
                                local forwardInput = moveVector:Dot(lockedRotation)
                                
                                -- Only allow forward/backward movement
                                local newVelocity = lockedRotation * forwardInput * 16
                                
                                -- Apply movement
                                hrp.CFrame = CFrame.new(hrp.Position + newVelocity * 0.016) * CFrame.lookAt(Vector3.new(0, 0, 0), lockedRotation)
                            else
                                -- Keep rotation locked even when not moving
                                hrp.CFrame = CFrame.new(hrp.Position) * CFrame.lookAt(Vector3.new(0, 0, 0), lockedRotation)
                            end
                        end
                    end
                end)
            end
            
            statusLabel.Text = "Status: Movement Locked"
        else
            if lockConnection then
                lockConnection:Disconnect()
                lockConnection = nil
            end
            lockedRotation = nil
            if not _G.AirWalkEnabled then
                statusLabel.Text = "Status: Ready"
            end
        end
    end
    
