    -- =====================
    -- LOGIKA AIRWALK
    -- =====================
    local function stopAirWalk()
        if airPart then
            airPart:Destroy()
            airPart = nil
        end
        if walkConnection then
            walkConnection:Disconnect()
            walkConnection = nil
        end
        if jumpConnection then
            jumpConnection:Disconnect()
            jumpConnection = nil
        end
        _G.AirWalkHeight = 0
        isOnGround = false
    end

    local function startAirWalk()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            _G.AirWalkHeight = player.Character.HumanoidRootPart.Position.Y - 3.2
        end

        if not airPart then
            airPart = Instance.new("Part")
            airPart.Name = "AirWalkPlatform_" .. player.UserId
            airPart.Size = Vector3.new(12, 0.4, 12)
            airPart.Anchored = true
            airPart.CanCollide = true
            airPart.Transparency = 0.45
            airPart.Material = Enum.Material.Neon
            airPart.Color = Color3.fromRGB(80, 255, 80)
            airPart.CastShadow = false
            airPart.Parent = workspace
        end

        -- Heartbeat: ikuti posisi horizontal player
        if not walkConnection then
            walkConnection = RunService.Heartbeat:Connect(function()
                if not (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) then return end
                local hrp = player.Character.HumanoidRootPart
                airPart.CFrame = CFrame.new(hrp.Position.X, _G.AirWalkHeight, hrp.Position.Z)
            end)
        end

        -- Deteksi jump → naikkan platform (efek tangga)
        if not jumpConnection then
            local wasJumping = false
            jumpConnection = RunService.Heartbeat:Connect(function()
                if not (player.Character and player.Character:FindFirstChild("Humanoid") and player.Character:FindFirstChild("HumanoidRootPart")) then return end
                local humanoid = player.Character.Humanoid
                local hrp = player.Character.HumanoidRootPart
                local state = humanoid:GetState()

                local jumping = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)

                if jumping and not wasJumping then
                    -- Player baru loncat: angkat target height
                    _G.AirWalkHeight = _G.AirWalkHeight + stepHeight
                    wasJumping = true
                elseif not jumping and wasJumping then
                    -- Player landing kembali ke platform
                    wasJumping = false
                    -- Snap height ke posisi player saat ini supaya smooth
                    task.wait(0.05)
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        _G.AirWalkHeight = player.Character.HumanoidRootPart.Position.Y - 3.2
                    end
                end
            end)
        end
    end

    local function updateUI()
        if _G.AirWalkEnabled then
            toggleBtn.Text = "AirWalk: ON"
            toggleBtn.TextColor3 = Color3.fromRGB(80, 255, 80)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(18, 70, 18)
            toggleBtn.BorderColor3 = Color3.fromRGB(80, 255, 80)
            statusLabel.Text = "Status: Active"
        else
            toggleBtn.Text = "AirWalk: OFF"
            toggleBtn.TextColor3 = Color3.fromRGB(140, 140, 140)
            toggleBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
            toggleBtn.BorderColor3 = Color3.fromRGB(55, 55, 55)
            statusLabel.Text = "Status: Ready"
        end
    end

    toggleBtn.MouseButton1Click:Connect(function()
        _G.AirWalkEnabled = not _G.AirWalkEnabled
        if _G.AirWalkEnabled then
            startAirWalk()
        else
            stopAirWalk()
        end
        updateUI()
    end)

    -- Reset saat respawn
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if _G.AirWalkEnabled then
            _G.AirWalkEnabled = false
            stopAirWalk()
            updateUI()
        end
    end)

    -- =====================
    -- CLOSE / MINIMIZE
    -- =====================
    local isMinimized = false

    closeBtn.MouseButton1Click:Connect(function()
        mainFrame.Visible = false
        iconButton.Visible = true
        isMinimized = true
    end)

    iconClickBtn.MouseButton1Click:Connect(function()
        mainFrame.Visible = true
        iconButton.Visible = false
        isMinimized = false
    end)

    -- =====================
    -- DRAG - MAIN FRAME
    -- =====================
    local UIS2 = game:GetService("UserInputService")
    local dragging, dragStart, startPos = false, nil, nil

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    UIS2.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- =====================
    -- DRAG - ICON
    -- =====================
    local iconDragging, iconDragStart, iconStartPos = false, nil, nil
    local iconMoved = false

    iconButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            iconDragging = true
            iconDragStart = input.Position
            iconStartPos = iconButton.Position
            iconMoved = false
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then iconDragging = false end
            end)
        end
    end)

    UIS2.InputChanged:Connect(function(input)
        if iconDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - iconDragStart
            if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then iconMoved = true end
            iconButton.Position = UDim2.new(iconStartPos.X.Scale, iconStartPos.X.Offset + delta.X, iconStartPos.Y.Scale, iconStartPos.Y.Offset + delta.Y)
        end
    end)
end

